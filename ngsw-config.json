{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.png", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/data/**"]
      }
    },
    {
      "name": "icons",
      "installMode": "prefetch",
      "resources": {
        "files": ["/icons/**"]
      }
    },
    {
      "name": "books",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/books/**"]
      }
    }
  ]
}
